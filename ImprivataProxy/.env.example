# Copy to `.env` and fill in. Never commit `.env`.

# ----- Required secrets ---------------------------------------------------
AD_SVC_PASSWORD=change-me-to-real-service-account-password
ADMIN_PASSWORD=change-me-to-strong-admin-password

# ----- Host / network -----------------------------------------------------
# Port on the host that maps to container:8080 (Imprivata client connects here).
PROXY_HOST_PORT=80

# ----- AD connection ------------------------------------------------------
AD_LDAP_URL=ldaps://dc.corp.example.com:636
AD_BASE_DN=OU=Users,DC=corp,DC=example,DC=com
AD_SERVICE_ACCOUNT_DN=CN=svc-imprivata,OU=Service,DC=corp,DC=example,DC=com
AD_SYNC_INTERVAL_MINUTES=30

# ----- Ticket lifetime ----------------------------------------------------
TICKET_TTL_HOURS=8
