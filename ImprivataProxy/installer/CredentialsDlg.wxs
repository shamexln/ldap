<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <UI>
      <Dialog Id="CredentialsDlg" Width="370" Height="270"
              Title="[ProductName] Setup">

        <!-- Top banner (standard WixUI appearance) -->
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <!-- Title and description in banner area -->
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Service Credentials" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="Enter the passwords for the Imprivata Proxy service." />

        <!-- AD Service Account Password field -->
        <Control Id="ADPasswordLabel" Type="Text" X="20" Y="60" Width="320" Height="13"
                 NoPrefix="yes"
                 Text="&amp;LDAP Service Account Password:" />
        <Control Id="ADPasswordEdit" Type="Edit" X="20" Y="74" Width="320" Height="18"
                 Property="AD_SVC_PASSWORD" Password="yes" />
        <Control Id="ADPasswordNote" Type="Text" X="20" Y="94" Width="320" Height="13"
                 NoPrefix="yes"
                 Text="Password for the AD service account used for LDAP binds." />

        <!-- Admin Console Password field -->
        <Control Id="AdminPasswordLabel" Type="Text" X="20" Y="118" Width="320" Height="13"
                 NoPrefix="yes"
                 Text="A&amp;dmin Console Password:" />
        <Control Id="AdminPasswordEdit" Type="Edit" X="20" Y="132" Width="320" Height="18"
                 Property="ADMIN_PASSWORD" Password="yes" />
        <Control Id="AdminPasswordNote" Type="Text" X="20" Y="152" Width="320" Height="13"
                 NoPrefix="yes"
                 Text="Password for the web-based administration console." />

        <!-- Security note -->
        <Control Id="SecurityNote" Type="Text" X="20" Y="180" Width="320" Height="26"
                 NoPrefix="yes"
                 Text="Both passwords are required. They are stored as service environment variables and will not appear in the installation log." />

        <!-- Bottom button bar (standard WixUI layout) -->
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)" />

        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

      </Dialog>
    </UI>
  </Fragment>

</Wix>
